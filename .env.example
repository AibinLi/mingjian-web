# Development-only defaults. Do not commit real secrets.
MINGJIAN_ENV=development
MINGJIAN_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Final jobs and their user-media bytes are actively removed after this period
# (60--86400 seconds). The production Compose default is 900 seconds.
MINGJIAN_RETENTION_SECONDS=900
# Bounded wall-clock limit for one local job (10--600 seconds).
MINGJIAN_JOB_TIMEOUT_SECONDS=120
# Optional analysis capabilities are disabled until their isolated smoke tests pass.
ENABLE_ASR=false
ENABLE_OCR=false
ENABLE_FACE=false
ENABLE_SYNC=false
ENABLE_RETRIEVAL=false
ENABLE_LLM=false
# Competition demo replay affects only the explicit refresh enrichment step.
# It is fail-closed and never falls back to live Tavily or DeepSeek calls.
DEMO_MODE=false
# Retrieval runs only through POST /api/v1/jobs/{id}/refresh-llm after media
# processing. The API does not read provider API keys.
MINGJIAN_RETRIEVAL_WORKER_URL=http://127.0.0.1:8005
MINGJIAN_LLM_ANALYSIS_URL=http://127.0.0.1:8006
# DeepSeek Worker listener; only the Worker process reads DEEPSEEK_API_KEY.
MINGJIAN_LLM_WORKER_PORT=8006
# Set these only in the corresponding internal Worker process; never commit keys.
# TAVILY_API_KEY=
# DEEPSEEK_API_KEY=
# CPU Whisper is isolated in its own worker and needs a larger bounded budget
# than the 10-second OCR/face/sync modules. Keep the API budget above the worker.
MINGJIAN_ASR_TIMEOUT_SECONDS=60
MINGJIAN_ASR_PIPELINE_TIMEOUT_SECONDS=70
# MINGJIAN_ASR_WORKER_URL=http://127.0.0.1:8003
# auto selects CUDA only when the installed PyTorch runtime actually exposes it.
MINGJIAN_VISUAL_DEVICE=auto
MINGJIAN_VISUAL_BATCH_SIZE=16
MINGJIAN_VISUAL_TIMEOUT_SECONDS=30
# Manually provision from the official OpenCV Zoo URL recorded by
# backend/app/face_detection.py; runtime downloads remain disabled.
# MINGJIAN_YUNET_MODEL=models/cache/opencv-yunet/face_detection_yunet_2023mar.onnx
# Four-dimensional review-risk weights. Values are normalized at runtime.
# They configure review ordering only and never create an automatic truth label.
MINGJIAN_SCORE_WEIGHT_AUTHENTICITY=0.40
MINGJIAN_SCORE_WEIGHT_CONTENT=0.25
MINGJIAN_SCORE_WEIGHT_PROVENANCE=0.10
MINGJIAN_SCORE_WEIGHT_INTERNET=0.25
MINGJIAN_SCORE_LOW_MAX=35
MINGJIAN_SCORE_HIGH_MIN=65
MINGJIAN_SCORE_MIN_COVERAGE=0.65
# Optional. Must point only to a fully validated active calibrator directory.
# Rejected/inactive/test-leakage/tampered artifacts are refused at runtime.
# MINGJIAN_CALIBRATOR_DIR=<evaluation-artifact-root>\phase6-active-calibrators

